def triad_energy_map(basis, ruler_anchor_ev):
    import math
    entries = [
        ("omega_UO_stage", basis["omega_UO"]),
        ("omega_OB_stage", basis["omega_OB"]),
        ("omega_UB_stage", basis["omega_UB"]),
    ]
    out = []
    for name, theta in entries:
        gamma = 1.0 + theta / (2.0 * math.pi)
        beta = math.sqrt(1.0 - 1.0 / (gamma * gamma))
        eta = math.atanh(beta)
        E_over_v = math.exp(eta)
        out.append({
            "name": name,
            "theta_rad": theta,
            "theta_deg": math.degrees(theta),
            "gamma_eq": gamma,
            "beta_eq": beta,
            "eta_rapidity": eta,
            "E_over_v": E_over_v,
            "E_ev": E_over_v * ruler_anchor_ev,
        })
    return out
```

